rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Ganti dengan email akun admin yang dibuat di Firebase Authentication.
      return request.auth != null && request.auth.token.email == 'gojek.dpsha0514@gmail.com';
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Toko & menu teks yang diisi driver lewat admin.html (tanpa foto).
    match /toko/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
